<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch screen: purple background, no visible icon. -->
    <style name="LaunchTheme" parent="android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_purple</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_purple</item>
    </style>
    <style name="NormalTheme" parent="android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
